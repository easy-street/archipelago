# Proton Pass secret references for development (checked in; contains no secrets).
# Rendered to .env.development.secrets by `pass-cli inject` (bun run env:secrets).
# A var listed here is by definition a SECRET: env-sync marks it sensitive on Vercel.
# Item: "env var secrets - development - archipelago-web" in the archipelago-engineering vault.

CLERK_SECRET_KEY={{ pass://archipelago-engineering/env var secrets - development - archipelago-web/CLERK_SECRET_KEY }}
CLERK_WEBHOOK_SIGNING_SECRET={{ pass://archipelago-engineering/env var secrets - development - archipelago-web/CLERK_WEBHOOK_SIGNING_SECRET }}
