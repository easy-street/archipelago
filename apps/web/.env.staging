# Catalog of ALL staging env vars for archipelago-web (checked in).
# Staging deploys as Vercel Preview (staging branch); vars synced unscoped to
# Preview so PR previews share them. Secrets resolve via .env.staging.pass.

# Clerk 
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase 
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only (secret — resolved from Proton Pass)
SUPABASE_SECRET_KEY=

# Public origin of this environment's deployment (absolute URLs: OG/unfurl meta, etc.)
VITE_PUBLIC_APP_URL=
