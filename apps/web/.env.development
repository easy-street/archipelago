# Catalog of ALL development env vars for archipelago-web (checked in).
# Non-secret values live here; secret vars appear as empty placeholders
# and are resolved from Proton Pass via .env.development.pass (bun run env:secrets).

# Clerk 
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase (local stack — `supabase start`; well-known local literals)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Server-only. The development value is the well-known local-stack literal
# (works only against supabase start) — real secrets live in Proton Pass.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Public origin of this environment's deployment (absolute URLs: OG/unfurl meta, etc.)
VITE_PUBLIC_APP_URL=
